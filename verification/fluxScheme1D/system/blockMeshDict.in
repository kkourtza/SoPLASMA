FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }

// 1D drift-diffusion verification mesh. NCELLS is substituted by Allrun.
scale   1;
L       1;
NX      NCELLS;

vertices
(
    (0 0 0) (1 0 0) (1 0.05 0) (0 0.05 0)
    (0 0 0.05) (1 0 0.05) (1 0.05 0.05) (0 0.05 0.05)
);

blocks ( hex (0 1 2 3 4 5 6 7) ($NX 1 1) simpleGrading (1 1 1) );

boundary
(
    left  { type patch; faces ((0 4 7 3)); }
    right { type patch; faces ((1 2 6 5)); }
    frontAndBack { type empty; faces ((0 3 2 1) (4 5 6 7) (0 1 5 4) (3 7 6 2)); }
);
