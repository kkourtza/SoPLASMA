dimensions      [0 0 0 0 0 0 0];
internalField   uniform 1;
boundaryField
{
    left          { type fixedValue; value uniform AVAL; }
    right         { type fixedValue; value uniform BVAL; }
    frontAndBack  { type empty; }
}
