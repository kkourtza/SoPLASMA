FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      ePotential;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../configuration/config"

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform $dirichletValueTop;
    }
    bottom
    {
        type            thinDielectricPotential;
        epsilonR        __EPSR__;
__THICK____BACK__        surfCharge      none;      // sigma = 0: this bed tests the CAPACITANCE alone
        value           uniform 0;
    }

    sides
    {
        type    zeroGradient;
    }

    frontAndBack
    {
        type    empty;
    }
}

