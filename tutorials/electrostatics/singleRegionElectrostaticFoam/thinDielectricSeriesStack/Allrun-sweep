#!/bin/bash
# Sweep the analytic series stack. 2026-09-03.
cd "${0%/*}" || exit 1
run_one () {  # name epsR thickEntry backEntry expected
    local n=$1 e=$2 t=$3 b=$4 exp=$5
    rm -rf run_$n; mkdir run_$n
    cp -r 0.orig system configuration run_$n/
    cp run_$n/system/fvSolution-foam run_$n/system/fvSolution
    mv run_$n/0.orig run_$n/0
    EPSR=$e THICK=$t BACK=$b /usr/bin/python3 -c "
import os,pathlib
p=pathlib.Path('run_$n/0/ePotential'); s=p.read_text()
s=s.replace('__EPSR__',os.environ['EPSR'])
s=s.replace('__THICK__',os.environ['THICK'])
s=s.replace('__BACK__',os.environ['BACK'])
p.write_text(s)"
    ( cd run_$n && blockMesh > log.blockMesh 2>&1 \
        && singleRegionElectrostaticFoam > log.solve 2>&1 )
    local T=$(ls run_$n | grep -E '^[0-9]+$' | sort -n | tail -1)
    /usr/bin/python3 -c "
import re,sys
try: s=open('run_$n/$T/ePotential').read()
except Exception as ex: print('  $n  RUN FAILED (%s)'%ex); sys.exit()
m=re.search(r'^\s*bottom\s*\n\s*\{(.*?)\n\s*\}', s, re.S|re.M)
if not m: print('  $n  no bottom patch'); sys.exit()
v=re.search(r'\bvalue\s+(?:nonuniform[^(]*\((.*?)\)|uniform\s+([-\d.eE+]+))', m.group(1), re.S)
xs=[float(x) for x in (v.group(1) or v.group(2)).split()]
mn,mx=min(xs),max(xs); exp=$exp
err=abs(0.5*(mn+mx)-exp)/max(abs(exp),1e-30)
print('  %-4s eps=%-3s  Vs=%.10g  analytic=%.10g  rel.err=%.2e  %s  (spread %.1e)'
      %('$n','$e',0.5*(mn+mx),exp,err,'PASS' if err<2e-4 else 'FAIL',mx-mn))
"
}
echo "=== thinDielectricPotential vs analytic  Vs = d/(d + epsR L),  L=1, V0=1"
NL=$'\n'
run_one a 5 "        thickness 0.5;${NL}"  "        backingPotential 0;${NL}"  0.0909090909090909
run_one b 5 "        thickness 5.0;${NL}"  "        backingPotential 0;${NL}"  0.5
run_one c 2 "        thickness 0.5;${NL}"  "        backingPotential 0;${NL}"  0.2
run_one d 5 ""                             ""                                  1.0
