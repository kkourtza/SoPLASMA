FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      ePotential;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../configuration/config"

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
__TOP__    bottom
    {
        type            floatingElectrodePotential;
        initialCharge   __Q0__;     // [C] total charge on the conductor
        value           uniform 0;
    }
__XLOW____XHIGH__
    frontAndBack
    {
        type    empty;
    }
}

