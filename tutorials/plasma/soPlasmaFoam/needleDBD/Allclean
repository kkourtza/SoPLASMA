#!/usr/bin/env bash
#
# needleDBD -- remove everything Allrun-serial generates, and nothing else.
#
# THE RULE: this script must delete only GENERATED files. Every path below is
# something a tool wrote. If you find yourself adding a hand-authored file here,
# that file is in the wrong place.

cd "${0%/*}" || exit 1

if [ -n "${WM_PROJECT_DIR:-}" ]; then
    . "$WM_PROJECT_DIR/bin/tools/CleanFunctions"
    cleanCase -noZero
fi

rm -rf 0 logs
rm -f  log.* case.foam

# ---------------------------------------------------------------------------
# The mesh, and everything derived from it.
rm -f  constant/needleDBD_extruded.msh
rm -rf constant/polyMesh
rm -f  constant/cellToRegion

# NOT `rm -rf constant/$region`.
#
# That directory is no longer purely generated -- it holds the region's
# electricalProperties and the #include stubs for the plasma dictionaries. It is
# all regenerated by plasmaSetupRegions.sh, so removing it is currently safe,
# BUT the moment a user edits one of those files by hand that stops being true.
# Delete the mesh and let the script rewrite the rest.
for region in gas dielectric; do
    rm -rf "constant/$region/polyMesh"
    rm -rf "system/$region"
done

# Table sets. Both are regenerated: constant/plasmaTables by the Boltzmann sweep
# at start-up, constant/ionTables by ionmob in Allrun step 5.
#
# They are SEPARATE directories precisely so this line cannot destroy the ion
# tables while leaving the sweep to think its own set is complete -- which is
# what happened when they shared one.
rm -rf constant/plasmaTables constant/ionTables

# Build artefacts of the dictionaries.
rm -f  system/changeDictionaryDict
rm -f  postProcessing -r 2>/dev/null

echo "cleaned. Hand-authored files kept:"
echo "    configuration/config"
echo "    constant/{regionProperties,plasmaSpeciesProperties,plasmaTransportProperties}"
echo "    constant/{photoionizationProperties,air_plasma.foam,air_plasma.mech.json}"
echo "    constant/<region>/electricalProperties"
echo "    system/{controlDict,fvSchemes,fvSolution,plasmaSimulationControls}"
echo "    etc/changeDictionary.{gas,dielectric}"
echo "    0.orig/"
