/*--------------------------------*- C++ -*----------------------------------*\
| needleDBD -- linear solvers                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../configuration/config"

// THIS IS THE ONLY fvSolution IN THE CASE, FOR EVERY BACKEND AND EVERY REGION.
// Edit it directly.
//
// NO -foam / -petsc PAIR. Other beds ship two whole dictionaries and have
// Allrun copy one over `system/fvSolution`, which makes that file a build
// artefact whose edits vanish silently, and duplicates every unrelated setting
// across two files that then drift. Unnecessary: an OpenFOAM solver dictionary
// SILENTLY IGNORES entries it does not use (MEASURED 2026-09-02 -- a PCG block
// carrying `agglomerator`, `nCellsInCoarsestLevel` and a `petsc { options }`
// sub-dictionary runs clean), so the `ePotential` block below carries BOTH
// backends and `$ePotentialSolver` in configuration/config picks one.
//
// NO PER-REGION COPIES EITHER. OpenFOAM reads fvSolution per region from
// system/<region>/ and does NOT fall back here, so those files must exist --
// but they are ten-line stubs that `#include "../fvSolution"`, generated by
// `tools/plasmaSetupRegions.sh`. Nothing is duplicated and nothing can drift.
// Re-run that script after splitMeshRegions, which overwrites the stubs with
// empty dummies.

solvers
{
    ePotential
    {
        // GAMG WITH AN ASSEMBLY-AWARE AGGLOMERATOR, because this case sets
        // `useImplicit true` (see configuration/config): the gas and the
        // dielectric are assembled into ONE matrix, whose mesh is an
        // `lduPrimitiveMeshAssembly` rather than an `fvMesh`.
        //
        // GAMG's DEFAULT agglomerator (`faceAreaPair`) does
        // `refCast<const fvMesh>` on it, and the run aborts with
        //
        //     --> FOAM FATAL ERROR:
        //     Attempt to cast type lduPrimitiveMeshAssembly to type fvMesh
        //
        // which reads like an internal error and is a solver-configuration
        // error. OpenFOAM ships `assembledFaceAreaPair` for exactly this
        // (src/finiteVolume/lduPrimitiveMeshAssembly/
        //  assemblyFaceAreaPairGAMGAgglomeration, TypeName
        //  "assembledFaceAreaPair").
        //
        // MEASURED 2026-09-01 on the two-region plate2D acceptance case
        // (20000 cells, per timestep), all reaching the same analytic answer
        // where they converge at all:
        //
        //   smoothSolver/GaussSeidel   2000 (cap), resid 3e-4   7.3% WRONG
        //   PCG/DIC                     114                     ok
        //   GAMG, default agglomerator  ABORT                    --
        //   GAMG + assembledFaceAreaPair 11                      ok
        //
        // The first row is the instructive one: reaching `maxIter` is NOT an
        // error, so ten consecutive unconverged solves were logged as normal.
        //
        // A NOTE ON SYMMETRY. Under `poissonScheme explicit` this matrix is a
        // pure Laplacian and symmetric, so PCG/DIC is also valid. Under
        // `semiImplicit` -- what this case uses -- the conductivity enters the
        // operator and it is no longer symmetric; use PBiCGStab/DILU rather
        // than PCG/DIC if you move off GAMG.
        // Chosen in configuration/config. The entries below that the chosen
        // solver does not use are ignored, which is what lets one block serve
        // every backend.
        solver                  $ePotentialSolver;

        // --- GAMG (native) ---
        agglomerator            assembledFaceAreaPair;
        nCellsInCoarsestLevel   20;
        mergeLevels             1;
        smoother                GaussSeidel;

        // --- PETSc ---
        // Used only when $ePotentialSolver is `petsc`, which also needs
        // "libpetscFoam.so" in `solverLibs`. `cg` because the explicit-scheme
        // operator is symmetric; under `semiImplicit` use a non-symmetric
        // Krylov method here too.
        petsc
        {
            options
            {
                ksp_type    cg;
                pc_type     hypre;
                mat_type    aij;
            }
        }

        tolerance               $linearTol;
        relTol                  $linearRelTol;
        maxIter                 2000;
    }

    // PIMPLE solves `<field>Final` on the last outer corrector. A missing
    // entry for it is a FATAL LOOKUP, not a fallback to the base entry.
    ePotentialFinal
    {
        $ePotential;
        relTol                  0;
    }

    n_e
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       $linearTol;
        relTol          $linearRelTol;
        maxIter         2000;
    }

    // CATCH-ALL for every transported species.
    //
    // With `activeSpecies fromMechanism` the case does NOT know the species
    // names in advance -- they come from the mechanism -- so they cannot be
    // listed. The regex covers whatever the mechanism turns out to produce,
    // and the `(Final)?` covers the PIMPLE variants. A named entry above still
    // wins, so a species needing its own tolerance can have one.
    "n_.*(Final)?"
    {
        // PBiCGStab/DILU, NOT smoothSolver/GaussSeidel and NOT DIC.
        //
        // These are drift-dominated advection-diffusion matrices: strongly
        // ASYMMETRIC, and not diagonally dominant where the drift is strong.
        // Gauss-Seidel smoothing stalls on them. MEASURED on the equivalent
        // needle bed 2026-08-30: 73 species solves hit the 2000-iteration cap
        // WITHOUT converging in the first 5 steps alone, e.g.
        //     n_O2m  2000 iterations, 1.43e-4 -> 9.52e-5   (factor 1.5)
        //     n_O2p  2000 iterations, 4.42e-4 -> 3.28e-4   (factor 1.3)
        // while n_e, which had its own PBiCGStab entry, converged in 9.
        //
        // The stall is on the LATER outer iterations, where the initial
        // residual is already ~1e-4; the first outer iteration converges in 2,
        // so reading only the first solve of a step is misleading.
        //
        // DIC is for SYMMETRIC matrices. DILU is its asymmetric counterpart
        // and is what these need.
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       $linearTol;
        relTol          $linearRelTol;
        maxIter         2000;
    }

    // Gas temperature: a symmetric conduction Laplacian with a large
    // rho*c_v/deltaT diagonal, so PCG/DIC converges in a couple of iterations.
    // Present even when gas energy is not solved -- unused costs nothing, a
    // missing entry is fatal.
    "(T_gas|T_gasFinal)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
        maxIter         1000;
    }
}

PIMPLE
{
    // The OUTER loop count. What decides whether the outer loop has CONVERGED
    // is `outerCoupling` in system/plasmaSimulationControls; these are the
    // per-field LINEAR tolerances used inside it, and editing them to fix an
    // outer-loop failure changes nothing.
    nOuterCorrectors    4;

    residualControl
    {
        ePotential
        {
            tolerance   1e-8;
            relTol      0;
        }
        n_e
        {
            tolerance   $outerTol;
            relTol      0;
        }
        // Every other transported species, whatever the mechanism named it.
        "n_.*"
        {
            tolerance   $outerTol;
            relTol      0;
        }
    }
}

