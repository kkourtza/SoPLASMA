// Convergence of the OUTER (Poisson <-> species) loop.
//
// Within a timestep the field and the densities are lagged relative to each
// other. Converging that loop is what makes the scheme second order: with a
// single corrector it is FIRST order whatever ddtSchemes says, because no
// amount of ddt accuracy repairs a lag. Measured on the shipped benchmark:
// p = 0.87 at one corrector, p = 1.94 converged.
//
// So temporal order is not selected, it is ACHIEVED -- and the run reports
// which it got rather than promising one.
outerCoupling
{
    // converged -> chase the coupling residual, second order
    // lagged    -> one corrector, deliberately first order, for scoping runs
    target            converged;

    // The coupling residual to reach. MUST be comfortably above the
    // linear-solver tolerance (>= 10x); the solver refuses otherwise. An outer
    // tolerance at the inner solver's own convergence floor can never be met,
    // so the loop silently runs to maxCorrectors every step -- a fixed
    // iteration count wearing the name of a convergence test.
    tolerance         1e-8;

    // A CAP, not a target: the loop exits as soon as the residual is met.
    maxCorrectors     20;

    // What to do when the cap is exhausted unconverged. `reduceDeltaT` halves
    // the step and is applied alongside the Courant and dielectric limits, so
    // the smallest limit still wins.
    onNonConvergence  reduceDeltaT;   // reduceDeltaT | warn | fatal
}
