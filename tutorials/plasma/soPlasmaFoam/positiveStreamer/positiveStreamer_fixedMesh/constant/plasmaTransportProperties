FoamFile { version 2.0; format ascii; class dictionary; object plasmaTransportProperties; }

chemistry
{
    mechanism       "constant/air_plasma.foam";
    tableDir        "constant/plasmaTables";
    lookupVariable  reducedE;
    tableKey        reducedE;
    sourceModel     reactions;
    outOfBounds     extrapolate;
    manifest        "constant/air_plasma.mech.json";

    // How the reaction source reaches the transport equations. This is the
    // only mode family in which ions have a loss channel at all: recombination
    // and detachment live in the heavy reaction set, which the legacy
    // in-equation sources never evaluate.
    //
    //   adaptive      (default) chooses PER CELL between the two below, on
    //                 the local stiffness L*dt. The criterion is local because
    //                 the stiffness is: a streamer head can be stiff while the
    //                 bulk is not, so a global choice would either pay the
    //                 integration cost everywhere or lose robustness where it
    //                 is needed. Both paths return the same P/L form, so a
    //                 stiff cell keeps its implicit sink and its positivity.
    //   implicitRate  instantaneous rate at the current iterate,
    //                 loss implicit via fvm::Sp. Second order ONCE THE OUTER
    //                 LOOP CONVERGES -- so it wants nOuterCorrectors > 1 --
    //                 with exact charge conservation, guaranteed positivity,
    //                 and one O(n_reactions) evaluation per cell.
    //   ode           stiff substep, mean rate over the step. First order, but
    //                 it integrates THROUGH stiffness. Use it when a chemical
    //                 timescale is far below deltaT.
    //   none          legacy: electron-impact only, so ions never decay.
    //
    // Which one a case needs is MEASURED, not guessed: the run reports
    // max(L*dt) and the Picard change at start-up, and warns when the
    // linearisation is not resolving the chemistry. See
    // BoltzmannSolver docs/numerics-chemistry-coupling.md section 8.
    chemistrySolver adaptive;

    // L*dt at which `adaptive` integrates a cell instead of linearising it.
    //
    // L is a species' loss COEFFICIENT (dn/dt = P - L n), so L*dt is the
    // number of loss timescales crossed in one step. Below 1 the species
    // barely decays in a step and linearising is accurate and cheap; far
    // above 1 it is consumed several times over within the step, and
    // linearising about a state the cell is leaving is extrapolation.
    //
    // 1.0 is where linearising stops being obviously safe, NOT a stability
    // limit -- the implicit sink keeps densities positive at any L*dt.
    //
    // LOWER it if the run reports the chemistry source still changing on the
    // last outer iteration while cells are already being integrated: the
    // warning says so and names the current value.
    // RAISING it buys speed and costs accuracy silently, in the cells that
    // are actually reacting. Watch the reported Picard change if you do.
    chemStiffnessLimit 1.0;

    // Cells below this electron density are skipped. 0 = every cell. Raise it
    // only against your own case's densities and check the reported active
    // fraction: a threshold above the background silently disables the
    // chemistry entirely, which looks exactly like a converged solution.
    chemActivityThreshold 0;

    // Used only by `ode`. rodas23 preserves the charge invariant ~70x better
    // than seulex and takes no Newton iterations, so there is no nonlinear
    // convergence failure to handle across a million cells.
    odeCoeffs { solver rodas23; absTol 1e-6; relTol 1e-4; }
    // never | interval | time | relativeChange
    //
    // A refresh RE-SOLVES the EEDF at the current composition and gas
    // temperature and reloads the tables (~0.45 s for 200 E/N points). Default
    // `never`: the tables are built once at start-up and are exact as long as
    // the composition and temperature stay near what they were built at.
    //
    // Worth knowing before switching it on: a refresh only changes anything if
    // the composition can actually move. With `include charged` no neutrals
    // are transported, so the mixture is pinned at the mechanism's reference
    // values and every refresh reproduces identical tables at full cost. It
    // becomes meaningful with `include chargedAndExcited`, or once gas heating
    // is solved.
    //
    // The sensitivity is real: at 100 Td, going from 79/21 air to a 50/50
    // N2/O2 mixture changes k[EI_N2_ION_N2] by 1.80x and the mobility by 1.17x.
    eedfRefresh     never;
    // refreshInterval 20;      // with `interval`: every N timesteps
    // refreshDeltaT   1e-10;   // with `time`: every N seconds

    // Sweep settings for the in-process EEDF solve. Omit the block entirely
    // and the defaults match what genMechTables would have produced.
    boltzmann
    {
        ENmin           0.1;
        // 2000 Td, not 500. The streamer HEAD field exceeds 500 Td once it
        // organises, and above the table the rate coefficients are
        // extrapolated -- a power law continued from the last tabulated
        // interval, which is a guess exactly where the physics is deciding
        // whether the streamer propagates.
        ENmax           2000;
        nPoints         200;
        Tgas            300;
        // 1 bar = 0.9869 atm, matching the benchmark's N = 2.414e25 m^-3.
        // This sets the density the three-body attachment tables are built
        // at, so it must agree with `pressure` in plasmaSpeciesProperties.
        pressureAtm     0.98692;
        growthModel     temporal;
    }
}
