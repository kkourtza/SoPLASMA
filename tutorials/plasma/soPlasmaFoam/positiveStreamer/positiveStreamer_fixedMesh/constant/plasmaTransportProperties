FoamFile { version 2.0; format ascii; class dictionary; object plasmaTransportProperties; }

chemistry
{
    mechanism       "constant/air_plasma.foam";
    tableDir        "constant/plasmaTables";
    lookupVariable  reducedE;
    tableKey        reducedE;
    sourceModel     reactions;
    outOfBounds     extrapolate;
    manifest        "constant/air_plasma.mech.json";
    // never | interval | time | relativeChange
    //
    // A refresh RE-SOLVES the EEDF at the current composition and gas
    // temperature and reloads the tables (~0.45 s for 200 E/N points). Default
    // `never`: the tables are built once at start-up and are exact as long as
    // the composition and temperature stay near what they were built at.
    //
    // Worth knowing before switching it on: a refresh only changes anything if
    // the composition can actually move. With `include charged` no neutrals
    // are transported, so the mixture is pinned at the mechanism's reference
    // values and every refresh reproduces identical tables at full cost. It
    // becomes meaningful with `include chargedAndExcited`, or once gas heating
    // is solved.
    //
    // The sensitivity is real: at 100 Td, going from 79/21 air to a 50/50
    // N2/O2 mixture changes k[EI_N2_ION_N2] by 1.80x and the mobility by 1.17x.
    eedfRefresh     never;
    // refreshInterval 20;      // with `interval`: every N timesteps
    // refreshDeltaT   1e-10;   // with `time`: every N seconds

    // Sweep settings for the in-process EEDF solve. Omit the block entirely
    // and the defaults match what genMechTables would have produced.
    boltzmann
    {
        ENmin           0.1;
        ENmax           500;
        nPoints         200;
        Tgas            300;
        pressureAtm     1.0;
        growthModel     temporal;
    }
}
