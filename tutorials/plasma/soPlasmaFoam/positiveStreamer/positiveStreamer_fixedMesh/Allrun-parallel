#!/usr/bin/env bash

configFile="configuration/config"

# -----------------------------------------------------------------------------
cd ${0%/*} || exit 1

./Allclean

# Create ParaView placeholder
touch "case.foam"

# Source run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# ----------------------------------------------------------------------------
mkdir -p constant

blockMesh

topoSet -dict system/topoSetDict1
refineMesh -dict system/refineMeshDict1 -overwrite
topoSet -dict system/topoSetDict2
refineMesh -dict system/refineMeshDict2 -overwrite
topoSet -dict system/topoSetDict3
refineMesh -dict system/refineMeshDict3 -overwrite
topoSet -dict system/topoSetDict4
refineMesh -dict system/refineMeshDict4 -overwrite
topoSet -dict system/topoSetDict5
refineMesh -dict system/refineMeshDict5 -overwrite

extrudeMesh

# ----------------------------------------------------------------------------
if [ -f "$configFile" ]; then
    # Extract the value assigned to matrixSolver, removing quotes and semicolons
    solverType=$(grep "matrixSolver" "$configFile" | awk '{print $2}' | tr -d '";')

    case "$solverType" in
        "petsc")
            echo "--> Detected Solver: PETSc"
            cp system/fvSolution-petsc system/fvSolution 2>/dev/null || echo "Warning: fvSolution-petsc missing!"
            ;;
        "foam")
            echo "--> Detected Solver: OpenFOAM Native"
            cp system/fvSolution-foam system/fvSolution 2>/dev/null || echo "Warning: fvSolution-foam missing!"
            ;;
        *)
            echo "Error: Unknown or missing matrixSolver type '$solverType' in $configFile"
            exit 1
            ;;
    esac
else
    echo "Error: Configuration file missing at $configFile"
    exit 1
fi

# -----------------------------------------------------------------------------
cp -r 0.orig/* 0/

# Create logs folder
mkdir -p logs

plasmaCreateSpeciesFields

cp etc/changeDictionary system/changeDictionaryDict
changeDictionary

# -----------------------------------------------------------------------------
# THE SEED IS THE CASE. Without it this is a quiescent gas in a Laplace
# field: it runs to completion, reports no error, and contains no streamer.
#
# It used to be `python initGaussianSeed.py` with NO status check, and it
# failed silently for two reasons at once -- `python` does not exist on a
# python3-only system, and the script imports `fluidfoam`, which was declared
# nowhere. Measured 2026-09-11: the case ran 2000 steps, 0 fatal errors, with
# n_e pinned at its 1e13 background the whole way. A tutorial that quietly
# solves the wrong problem is worse than one that stops.
python3 initGaussianSeed.py || {
    echo "" >&2
    echo "initGaussianSeed.py FAILED -- refusing to run a streamer case with no streamer." >&2
    echo "  It needs numpy and fluidfoam:   pip install fluidfoam" >&2
    echo "  Without the seed the case is a quiescent gas and every result is meaningless." >&2
    exit 1
}

decomposePar

runParallel $(getApplication)

reconstructPar

