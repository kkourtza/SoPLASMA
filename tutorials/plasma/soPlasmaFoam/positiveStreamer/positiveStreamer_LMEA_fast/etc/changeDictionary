FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ePotential
{
    internalField   uniform 0;

    boundaryField
    {
        ".*"
        {
            type            zeroGradient;
        }

        axis 
        {
            type            empty;
        }

        wedge_0 
        {
            type            wedge;
        }

        wedge_1 
        {
            type            wedge;
        }

        grounded_electrode
        {
            type            fixedValue;
            value           uniform 0;
        }

        active_electrode
        {
            // Ramped, not a step. The benchmark specifies a constant 18.75 kV
            // from t=0; ramping withholds part of the applied field over the
            // first ~94 ps, so early-time behaviour is NOT directly comparable
            // with the reference. Kept deliberately: a step change puts a very
            // large field transient on the electrode in the first timesteps.
            type            uniformFixedValue;
            uniformValue    table ((0 0) (9.375000e-11 18750));
            value           uniform 0;
        }

        "procBoundary.*"
        {
            type            processor;
        }
    }
}

