n_e
{
    internalField   uniform 1e13;

    boundaryField
    {
        ".*"
        {
            type            zeroGradient;
        }
        axis 
        {
            type            empty;
        }

        wedge_0 
        {
            type            wedge;
        }

        wedge_1 
        {
            type            wedge;
        }

        grounded_electrode
        {
            type            zeroGradient;
        }

        active_electrode
        {
            type            zeroGradient;
        }

        far
        {
            type            inletOutlet;
            phi             particleFlux_e;
            inletValue      uniform 1e13;
            value  $internalField;
        }

        "procBoundary.*"
        {
            type            processor;
        }
    }
}

n_N2p
{
    // Background positive charge is split between the ions in proportion to
    // the gas: 7.9e12 + 2.1e12 = 1e13 = n_e, so the undisturbed gas is
    // quasi-neutral and matches the clamp floors exactly. A mismatch here
    // would be clamped away on step 1, as a jump rather than as an error.
    internalField   uniform 7.9e12;

    boundaryField
    {
        ".*"
        {
            type            zeroGradient;
        }

        axis 
        {
            type            empty;
        }

        wedge_0 
        {
            type            wedge;
        }

        wedge_1 
        {
            type            wedge;
        }

        grounded_electrode
        {
            type            zeroGradient;
        }

        active_electrode
        {
            type            zeroGradient;
        }

        far
        {
            type            zeroGradient;
        }

        "procBoundary.*"
        {
            type            processor;
        }
    }
}

