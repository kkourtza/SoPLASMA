FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../configuration/config"

solvers
{
    ePotential
    {
        solver          GAMG;
	    smoother        GaussSeidel;
        tolerance       $ePotentialTolerance;
        relTol          0;
        maxIter         2000;
    }
    ePotentialFinal
    {
        $ePotential;
        relTol          0;
    }

    n_e
    {
        solver          PBiCGStab;
        smoother        GaussSeidel;
	    preconditioner  DILU;
        tolerance       $neTolerance;
        relTol          0;
        maxIter         2000;
    }

    // Catch-all for every transported species. With `activeSpecies
    // fromMechanism` the case does NOT know the species names in advance --
    // they come from the mechanism -- so they cannot be listed here. A regex
    // covers whatever the mechanism turns out to produce.
    //
    // A named entry above still wins over this, so a species that needs its
    // own tolerances can have them.
    // Matches the ...Final variants too: PIMPLE solves `n_<sp>Final` on the
    // last outer corrector, and a missing entry for it is a fatal lookup, not
    // a fallback.
    "n_.*(Final)?"
    {
          // PBiCGStab/DILU, NOT smoothSolver/GaussSeidel and NOT DIC.
          //
          // These are drift-dominated advection-diffusion matrices: strongly
          // ASYMMETRIC and not diagonally dominant where the drift is strong.
          // Gauss-Seidel DIVERGES on them, and only on the FINAL corrector --
          // the literal `n_e` entry above wins for `n_e` but NOT for `n_eFinal`,
          // so one step ran two different solvers on the same field:
          //
          //     corrector 1  DILUPBiCGStab  n_e  1.31e-03 -> 1.88e-11,    7 its
          //     corrector 2  smoothSolver   n_e  5.26e-04 -> 1.86e+67, 2000 its
          //
          // MEASURED 2026-09-12 on the warm streamer bed: the Gauss-Seidel
          // spectral radius rho = (final/initial)^(1/its) crosses 1 at
          // dt = 1.53e-10 -- 0.419 / 0.609 / 0.848 / 1.085 / 1.379 at
          // dt = 1.0 / 1.2 / 1.4 / 1.6 / 1.8e-10 -- while the Krylov solver on
          // the SAME step stays flat at 4-9 iterations. Changing ONLY this entry
          // takes the identical matrix and RHS (initial residual matching to 12
          // digits) from 2000 divergent sweeps to 5 Krylov iterations, and the
          // arm from SIGFPE at step 2 to reaching the endpoint.
          //
          // DIC is inert under smoothSolver and wrong for an asymmetric matrix
          // anyway; it is dropped rather than carried forward.
          //
          // SAME defect fixed in needleDBD 2026-08-30 and never propagated here
          // (B4: a bug is a property of the MECHANISM, not of the call site that
          // exposed it). An entire dt ladder was measuring this smoother rather
          // than the physics.
          solver          PBiCGStab;
          preconditioner  DILU;
        tolerance       $npIonTolerance;
        relTol          0;
        maxIter         2000;
    }

    // Gas temperature: symmetric conduction Laplacian with a large
    // rho*c_v/dt diagonal, so PCG+DIC converges in a couple of iterations.
    "(T_gas|T_gasFinal)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       $TgasTolerance;
        relTol          0;
        maxIter         1000;
    }
}

PIMPLE
{
    nOuterCorrectors    $nOuterCorrectors;
    residualControl
    {
        ePotential
        {
            tolerance   $ePotentialTolerancePIMPLE;
            relTol      0;
        }
        n_e
        {
            tolerance   $neTolerancePIMPLE;
            relTol      0;
        }
        // Every other transported species, whatever the mechanism named it.
        "n_.*"
        {
            tolerance   $npIonTolerancePIMPLE;
            relTol      0;
        }

    }


}

