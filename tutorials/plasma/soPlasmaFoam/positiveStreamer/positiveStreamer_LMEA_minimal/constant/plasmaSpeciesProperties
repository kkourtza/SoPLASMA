FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      plasmaSpeciesProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * /
#include "../configuration/config"

// Derived from the mechanism rather than repeated here. The mechanism already
// knows which species its reactions create; listing them again is how a case
// ends up NOT transporting an ion the chemistry produces, which breaks charge
// conservation silently. An explicit list still works and still wins.
// THE one switch. LMEA solves the electron energy-density equation and keys
// all electron transport and reaction rates on the local mean energy.
// This bed KEEPS its explicit energyModelCoeffs block below, as the
// regression test that a hand-written block still overrides the defaults.
electronEnergyModel LMEA;

activeSpecies fromMechanism;

mechanismSpecies
{
    mechanism   "constant/air_plasma.foam";

    // charged | chargedAndExcited | all
    //   charged            electron + ions. The minimum for a self-consistent
    //                      discharge -- these carry the space charge.
    //   chargedAndExcited  adds excited states and radicals; needed once
    //                      stepwise ionisation or quenching matters, at one
    //                      transport equation each.
    //   all                also transports the background gas, which is held
    //                      fixed by construction, so this is rarely wanted.
    include     chargedAndExcited;
    neutralTransport immobile;
}

backgroundGas
{
  name  "Air";
  // numberDensity omitted: closed by the ideal gas law from
  // pressure and the temperature stated below.
  // 1 bar, not 1 atm: the benchmark this case reproduces states
  // N = 2.414e25 m^-3 at 300 K, which is 1e5 Pa. Using 101325 Pa gives
  // 2.446e25, a 1.3% denser gas -- small, but it shifts E/N and therefore
  // every rate coefficient, so it is not the kind of difference to leave
  // unexplained in a validation case.
  pressure        1e5;
  energy
  {
    solve   true;
    T       300;
    kappa   0.026;
    pressure 1e5;
  }
}

speciesProperties
{
  e
  {
    transportModel            driftDiffusion;
    charge                    -1;
    mass                      9.109e-31;

    // 1e13, the benchmark's background density, not a numerical floor of 1e5.
    //
    // The background field is 62 Td, well below this mixture's 115-120 Td
    // critical field, so the bulk is net-ATTACHING: left free, the background
    // electrons decay and the seed is starved of the electrons a positive
    // streamer needs drawn into its head. Holding them at the background value
    // keeps that reservoir, which is what the benchmark assumes.
    //
    // IMPLICATION: a clamp is a source. Electrons are injected wherever
    // attachment would have removed them, so this only conserves charge
    // because the positive ions are clamped to the same total (below). Do not
    // raise one without the other.
    minNumberDensity          1e13;

    // LMEA: transport the electron energy instead of taking the mean energy
    // from the LFA table. The transport coefficients above now look up
    // `meanE`, the field this model publishes, rather than `reducedE`.
    // energyModel: superseded by the top-level electronEnergyModel.

    // NO energyModelCoeffs BLOCK. That is the point of this case.
    //
    // `electronEnergyModel LMEA` above configures all of it from the
    // mechanism's own tables: mobility/diffusivity (muN/DLN),
    // energyMobility/energyDiffusivity (muEpsN/DEpsN), powerLoss
    // elastic/inelastic, and the initialMeanEnergy seed. Verified
    // 2026-09-01 to produce BYTE-IDENTICAL fields to the explicit
    // 80-line block kept in positiveStreamer_LMEA_fast.


    driftDiffusionCoeffs
    {
      fluxScheme                $driftDiffusionFluxScheme;

      // Electron transport from the Boltzmann solver's own EEDF, so the
      // electrons and the chemistry are described by the same cross sections.
      //
      // The alternative -- the powerLaw fit this case used to carry -- is still
      // available and is kept below, commented, for comparison. It is not
      // wrong, but it is INDEPENDENT of the mechanism: nothing detects it
      // disagreeing with the rate coefficients the same run interpolates.
      //
      // Tables hold mu*N and D*N; the evaluator divides by the gas density, so
      // the values follow density automatically. They were solved at ONE
      // mixture and gas temperature, which is the same local-field assumption
      // the rate coefficients already make.
      mobility
      {
        type                    fromMechanism;
        quantity                muN;
        tableDir                "constant/plasmaTables";
      }

      diffusivity
      {
        type                    fromMechanism;
        quantity                DLN;
        tableDir                "constant/plasmaTables";
      }

      // Hand-fitted alternative, kept for comparison:
      //   mobility    { type powerLaw; lookupVariable E; amplitude 2.398;    exponent -0.26; }
      //   diffusivity { type powerLaw; lookupVariable E; amplitude 4.3628e-3; exponent 0.22; }
    }
  }

  // Positive-ion floors sum to the ELECTRON floor, split by the mole fractions
  // of the gas that produces them: 0.79 + 0.21 = 1.00 x 1e13. The undisturbed
  // background is therefore quasi-neutral by construction, so clamping cannot
  // manufacture net space charge -- which would drive a Poisson field out of
  // nothing. Raise one of these three and you must raise the others.
  //
  // Negative ions keep the 1e5 floor: they are reaction products, not
  // background, and floors on them would put net negative charge into
  // undisturbed gas.
  N2p
  {
    transportModel            immobile;
    charge                    +1;
    mass                      4.6495e-26;
    minNumberDensity          7.9e12;
  }

  O2p
  {
    transportModel            immobile;
    charge                    +1;
    mass                      5.3137e-26;
    minNumberDensity          2.1e12;
  }

  Om
  {
    transportModel            immobile;
    charge                    -1;
    mass                      2.6569e-26;
    minNumberDensity          1e5;
  }

  O2m
  {
    transportModel            immobile;
    charge                    -1;
    mass                      5.3137e-26;
    minNumberDensity          1e5;
  }
}
