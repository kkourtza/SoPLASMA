FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      n_Ar2p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    side_lo
    {
        type            symmetryPlane;
    }
    anode
    {
        type            ionDDWallFluxMixed;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        source          uniform 0;
        value           uniform 0;
        T               300;
        enableSurfaceCharging false;
    }
    side_hi
    {
        type            symmetryPlane;
    }
    cathode
    {
        type            ionDDWallFluxMixed;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        source          uniform 0;
        value           uniform 0;
        T               300;
        enableSurfaceCharging false;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


