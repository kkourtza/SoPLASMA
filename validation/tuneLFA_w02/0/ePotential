FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      ePotential;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    side_lo
    {
        type            symmetryPlane;
    }
    anode
    {
        type            fixedValue;
        value           uniform 0;
    }
    side_hi
    {
        type            symmetryPlane;
    }
    cathode
    {
        type            uniformFixedValue;
        uniformValue    table;
        uniformValueCoeffs
        {
            values          
2
(
(0 0)
(5e-06 -500)
)
;
        }
        value           uniform 0;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


