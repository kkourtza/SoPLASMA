/*--------------------------------*- C++ -*----------------------------------*\
|  Master Simulation Configuration: Physical, Numerical & Solver Parameters   |
\*---------------------------------------------------------------------------*/


//- Gas state. Grubert: argon at 100 Pa, 300 K.
//  100 Pa gives N = 2.414e22 m^-3, so the MEAN field -500 V over 1 cm is
//  E/N = 2071 Td -- and the cathode fall reaches far higher, which is why the
//  Boltzmann sweep runs to 55000 Td.
gasPressure                         100;      // [Pa]
gasTemperature                      300;      // [K]

//- Global Numerical Schemes (Macros for fvSchemes)
// ScharfetterGummel, not `standard`. On this case the standard branch of the
// wall-flux condition went SINGULAR at the anode at t = 1.1e-7 s:
// (D/delta + uEff)/(D/delta) = -9.26. With electron reflection r = 0.36 the
// closure returns W = (1-r)*w_w, so uEff = (1-r)/(1+r)*(A + uDrift) - uDrift
// goes negative once uDrift > 0.889*A -- `includeDriftFlux true` does NOT
// remove the mode for a reflecting wall, only for r = 0. The SG denominator
// is D/delta*Bern(Pe) + uAbs, non-negative for any r, and SG is in any case
// the right scheme for a drift-dominated near-wall cell. Measured 2026-09-06.
driftDiffusionFluxScheme            ScharfetterGummel;
ddtSchemes                          backward;
gradSchemes                         leastSquares;

//- Species-Specific Schemes
electronDriftDivScheme                  Gauss ROUNDF;
electronDiffusionLaplacianScheme        Gauss harmonic corrected 0.33;
ePotentialLaplacianScheme               Gauss linear corrected 0.33;
electronMobilityInterpolationScheme     harmonic;
electronDiffusivityInterpolationScheme  harmonic;
ePotentialSnGradScheme                  corrected 0.33;
snGradSpeciesScheme                     corrected 0.33;

//- Matrix Solver & PETSc Settings
matrixSolver                        "foam";
nNonOrthogonalCorrectors            0;
nOuterCorrectors                    4;
ePotentialTolerancePIMPLE           1e-10;
neTolerancePIMPLE                   1e-10;
npIonTolerancePIMPLE                1e-10;

ePotentialMatrixCacheUpdate         always;
ePotentialPreconditionerCacheUpdate always;
TgasTolerance                       1e-12;
ePotentialTolerance                 1e-10;
ePotentialRelTolerance              0.0;

neMatrixCacheUpdate                 always;
nePreconditionerCacheUpdate         always;
neTolerance                         1e-10;
neRelTolerance                      0.0;

npIonMatrixCacheUpdate              always;
npIonPreconditionerCacheUpdate      always;
npIonTolerance                      1e-10;
npIonRelTolerance                   0.0;

//- Solution Control
poissonScheme                       semiImplicit;
adjustTimeStep                      true;
limitDielectricRelaxationRatio      false;
printDielectricRelaxationRatio      true;
maxDielectricRelaxationRatio        5;
limitSpeciesCo                      true;
printSpeciesCo                      true;
maxSpeciesCo                        1.5;
limitChemistryCo                    true;
printChemistryCo                    true;
maxChemistryCo                      0.9;

//- Runtime & Parallelization
endTime                             2e-7;   // tuning only -- the choke is at 1.1e-7
deltaT                              1e-12;
writeControl                        runTime;
writeInterval                       4.5e-6;
numberOfSubdomains                  4;

// ************************************************************************* //

// Voltage-rise resolution limit [V/step]; 0 disables it.
// Migrated 2026-09-01 from the deprecated pair
// `limitVoltageRiseRate` + `maxVoltageRiseRate`. This bed had the
// limiter off; now set to 100 V/step like every other bed (user, 2026-09-01).
maxVoltageRisePerStep               100;
