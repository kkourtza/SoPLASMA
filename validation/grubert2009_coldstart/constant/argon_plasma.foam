// Mixture-averaged diffusion coefficients [m^2/s] at Tref, pref,
// from Chapman-Enskog with the Neufeld collision integral and
// Blanc's law over the reference composition. Scale as
//   D(T,p) = D0 (T/Tref)^exponent (pref/p)
//
// The exponent is FITTED per species over 300-3000 K, not taken
// as the textbook 3/2. Chapman-Enskog gives D ~ T^1.5/Omega_D(T*),
// and Omega_D falls with temperature, so 1.5 alone is 22% low at
// 1000 K and 30% low at 2000 K -- in a gas-heating case that is a
// systematic error in exactly the regime the case exists to study.
// Charged species are absent on purpose: their transport is
// measured (ionmob/LXCat), not estimated. So are the background
// species of the reference composition: they are the reservoir,
// and Blanc's law cannot give a species its own self-diffusion.
speciesDiffusivity
{
    Tref         300;
    pref         100000;

}

speciesAlias
{
    Ar2p  "Ar2+";
    Arp  "Ar+";
}

processes
(
    { index 38; id EI_AR_ION_AR; target Ar; reactants (Electron Ar); products (Arp Electron Electron); deltaE 0; fGas 0; fVib 0; fElec 0; threshold 15.76; }
);

// Heavy chemistry: everything that is NOT electron impact --
// recombination, ion-ion neutralisation, detachment, quenching.
//
// Rates are Arrhenius, k = A T^b exp(-Ta/T), in molecular units
// (m^3/s, or m^6/s where an order-3 reaction names a collider).
// No EEDF is involved, which is why these do not need the
// Boltzmann solver and can be evaluated directly.
//
// WHICH T, and this line used to say `the GAS temperature` for all
// of them, which was wrong for any reaction with an electron
// reactant. In a non-equilibrium plasma the electrons sit at Te and
// the heavy species at T_gas, and a rate follows the temperature of
// whichever partner's speed sets the collision rate:
//
//   heavy + heavy     -> T_gas  (ion conversion, quenching, ...)
//   electron + heavy  -> Te     (dissociative recombination, ...)
//
// `No EEDF is involved` is true but is NOT the same as `gas
// temperature`: a dissociative recombination coefficient depends on
// Te without needing any EEDF integral. Corrected 2026-09-05; the
// solver DERIVES the choice from whether an electron is a reactant,
// so nothing has to be declared here.
//
// Stoichiometry is expanded by repetition, as in `processes` above,
// so one source-term loop can apply both.
nHeavyReactions 2;

heavyReactions
(
    { index 0; id HV_0; equation "Ar + Ar+ + Ar => Ar2+ + Ar"; order 3; reactants (Ar Arp); products (Ar2p); collider Ar; deltaH -1.23; A 2.5000000000e-43; b 0; Ta 0; }
    { index 1; id HV_1; equation "Ar2+ + Electron => 2 Ar"; order 2; reactants (Ar2p Electron); products (Ar Ar); deltaH -14.5939; A 2.9518000000e-11; b -0.61; Ta 0; }
);

