nProcesses      39;

// The electron under the name used in `reactants` and `products` above.
// OpenFOAM cases name their own electron species freely -- `e` in the
// streamer tutorial -- so the two must be matched through a declaration
// rather than by assuming a spelling. Code that tested for the literal
// "e" worked only by coincidence and would silently do nothing for a
// case that called it anything else.
electronSpecies Electron;

// Reference composition the mechanism was authored at. Used for target
// species that are part of the background gas rather than transported.
composition
{
    Ar  1.0;
}

// Mapping from OpenFOAM-safe names back to the mechanism's. An
// OpenFOAM `word` cannot contain ( ) ' or , so the names above are
// sanitised; this records what they were.
// Charge of every species the mechanism touches, in units of e.
// OpenFOAM cannot know the charge of a species it does not transport,
// so discarding one silently would break charge conservation -- this
// is what lets the solver make that fatal instead of merely noisy.
speciesCharge
{
    Ar  0;
    Ar2p  1;
    Arp  1;
    Electron  -1;
}

// Mass of every species the mechanism touches, in kg.
// Computed from the elemental composition Cantera already has, so a
// case does not have to type molecular masses by hand -- which is
// how N2+ and O2+ end up sharing one rounded 1.67e-26 that belongs to
// neither of them.
