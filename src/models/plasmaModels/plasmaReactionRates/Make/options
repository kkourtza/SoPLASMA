/* Follows the SoPLASMA convention: include paths via $(SoPLASMA_SRC)/.../lnInclude,
   libraries via -L$(FOAM_USER_LIBBIN). No external dependency at this stage --
   the rate tables are plain OpenFOAM interpolationTable files, so Stage 1 needs
   neither Cantera nor BoltzmannSolver linked in. */

EXE_INC = \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(SoPLASMA_SRC)/models/plasmaModels/genericPlasmaProperties/lnInclude \
    -I$(SoPLASMA_SRC)/models/plasmaModels/plasmaSpecies/lnInclude \
    -I$(SoPLASMA_SRC)/constants/lnInclude

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(FOAM_USER_LIBBIN) \
    -lplasmaProperties \
    -lplasmaSpecies \
    -lSoPLASMAConstants
