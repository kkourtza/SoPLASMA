    // SEE yield from Seiler (1983) R1; see the note above.
    reference        "Michaelson (1977), polycrystalline.";
}
iron
{
    phi              4.50;
    deltaMax         1.3;
    energyDeltaMax   400.0;
    // SEE yield from Seiler (1983) R1; see the note above.
    reference        "Michaelson (1977), polycrystalline.";
}
titanium        { phi 4.33; reference "Michaelson (1977), polycrystalline."; }
graphite
{
    phi              5.00;
    deltaMax         1.0;
    energyDeltaMax   300.0;
    // Carbon coatings are used to SUPPRESS multiplication.
