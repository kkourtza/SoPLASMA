# Determine SoPLASMA root directory (one level above this file)
export SoPLASMA=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
alias SoPLASMA='cd "$SoPLASMA"'

export SoPLASMA_ETC="$SoPLASMA/etc"

export SoPLASMA_TUTORIALS="$SoPLASMA/tutorials"

export SoPLASMA_SRC="$SoPLASMA/src"

export SoPLASMA_THIRD_PARTY="$SoPLASMA/ThirdParty"

# PETSc, built 2026-09-09 for the SNES/Newton outer-solver work (see
# doc/newton-outer-solver-design.md). Overrides whatever OpenFOAM's own
# etc/bashrc set PETSC_DIR to (a nonexistent system path on this apt-style
# OpenFOAM install) -- source THIS file after OpenFOAM's own bashrc so this
# wins. Built project-locally rather than under the system OpenFOAM tree
# because /usr/lib/openfoam/openfoam2412/ThirdParty is a stub file
# ("system dependencies"), not a real directory, on this installation.
export PETSC_DIR="$SoPLASMA_THIRD_PARTY/petsc-3.24.0"
export PETSC_ARCH="DPInt32"
export LD_LIBRARY_PATH="$PETSC_DIR/$PETSC_ARCH/lib:$LD_LIBRARY_PATH"
