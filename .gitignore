# Ignore ALL wmake-generated build folders
**/linux64Gcc**/

# Ignore object files and dep files (even if outside that folder)
*.o
*.dep

# Ignore OpenFOAM wmake temporary metadata
sourceFiles
variables

# Ignore tests folder
/tests

# Ignore TODO file
/TODO.md

/auxFiles

# Ignore vscode files
.vscode


# local validation/scratch run directories (not part of the source tree)
smoke/

# per-component build logs and local run helpers: machine-specific, and they
# churn on every build
buildlogs/
build.log
rebuild.log

# local run helpers: personal workflow, not part of the toolkit. build-all.sh
# is kept -- it is the documented, dependency-ordered build entry point.
watchdog.sh
check-run.sh
make-smoke-case.sh
rerun.sh
run-guarded.sh
run-long.sh
